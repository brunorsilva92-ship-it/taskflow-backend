generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model clientes {
  id              Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  data_nascimento DateTime? @db.Date
  pedidos         pedidos[]
}

model comentarios {
  tarefa_id  Int     @id(map: "comentarios_pk") @default(autoincrement())
  texto      String?
  usuario_id Int     @default(autoincrement())
  tarefas    tarefas @relation(fields: [tarefa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "comentarios_tarefas_fk")
}

model pedidos {
  id           Int            @id @default(autoincrement())
  data         DateTime?      @default(now()) @db.Timestamp(6)
  idcliente    Int?
  clientes     clientes?      @relation(fields: [idcliente], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pedidositens pedidositens[]
}

model pedidositens {
  id         Int       @id @default(autoincrement())
  idpedido   Int?
  idproduto  Int?
  valor      Decimal   @default(0.00) @db.Decimal(18, 2)
  desconto   Decimal?  @default(0.00) @db.Decimal(18, 2)
  quantidade Decimal   @default(1.00) @db.Decimal(18, 2)
  pedidos    pedidos?  @relation(fields: [idpedido], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produtos   produtos? @relation(fields: [idproduto], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model prioridades {
  id        Int       @id(map: "prioridades_pk") @default(autoincrement())
  descricao String?   @db.VarChar(20)
  criado_em DateTime? @default(now()) @db.Timestamp(6)
  ativo     Boolean?
  cor       String    @default("#94a3b8") @db.VarChar(7)
  tarefas   tarefas[]
}

model produtos {
  id              Int             @id @default(autoincrement())
  descricao       String          @db.VarChar(150)
  idunidademedida Int?
  pedidositens    pedidositens[]
  unidadesmedida  unidadesmedida? @relation(fields: [idunidademedida], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model projetos {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(100)
  descricao  String?
  usuario_id Int
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tarefas    tarefas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tarefas {
  id            Int          @id @default(autoincrement())
  texto         String
  coluna        String       @default("afazer") @db.VarChar(20)
  usuario_id    Int?
  criado_em     DateTime?    @default(now()) @db.Timestamp(6)
  iniciada_em   DateTime?    @db.Timestamp(6)
  concluida_em  DateTime?    @db.Timestamp(6)
  prioridade_id Int?
  projeto_id    Int?
  comentarios   comentarios?
  prioridades   prioridades? @relation(fields: [prioridade_id], references: [id], onUpdate: NoAction)
  projetos      projetos?    @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios      usuarios?    @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model unidadesmedida {
  id        Int        @id @default(autoincrement())
  sigla     String     @unique @db.VarChar(3)
  descricao String     @db.VarChar(50)
  produtos  produtos[]
}

model usuarios {
  id         Int        @id @default(autoincrement())
  nome       String     @db.VarChar(100)
  email      String     @unique @db.VarChar(100)
  senha_hash String     @db.VarChar(255)
  criado_em  DateTime?  @default(now()) @db.Timestamp(6)
  projetos   projetos[]
  tarefas    tarefas[]
}
